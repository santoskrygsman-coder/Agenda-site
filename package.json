{
  "name": "agendamento-estetica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:backup": "node scripts/export-sqlite-backup.mjs",
    "db:use-postgres": "node scripts/switch-prisma-provider.mjs postgresql && npx prisma generate",
    "db:use-sqlite": "node scripts/switch-prisma-provider.mjs sqlite && npx prisma generate",
    "db:migrate-data": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:migrate-auto": "node scripts/auto-migrate-supabase.mjs",
    "deploy:auto": "node scripts/auto-deploy-netlify.mjs",
    "uploads:migrate": "node scripts/migrate-uploads-to-supabase.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
