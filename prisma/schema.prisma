generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now())
  appointments Appointment[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int      // Minutos
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  appointments Appointment[]
}

model Appointment {
  id         String   @id @default(cuid())
  clientId   String
  serviceId  String
  date       String   // Formato YYYY-MM-DD para facilitar buscas
  startTime  String   // Formato HH:MM
  endTime    String   // Formato HH:MM
  status     String   @default("PENDING") // PENDING, CONFIRMED, REJECTED, CANCELED
  notes      String?
  whatsappStatus String @default("NOT_SENT") // NOT_SENT, OPENED, SENT_MANUALLY
  whatsappOpenedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client     Client   @relation(fields: [clientId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])
}

model WorkingHours {
  id         String   @id @default(cuid())
  weekday    Int      // 0 (Dom) a 6 (Sab)
  startTime  String   // "08:00"
  endTime    String   // "18:00"
  breakStart String?  // "12:00"
  breakEnd   String?  // "13:00"
  active     Boolean  @default(true)

  @@unique([weekday])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   @unique // Formato YYYY-MM-DD
  reason    String?
}

model Settings {
  id                 String   @id @default(cuid())
  professionalName   String   @default("Designer de Sobrancelhas")
  specialty          String   @default("Especialista em olhar")
  description        String?
  address            String?
  whatsapp           String?  // Opcional, para exibição pública
  instagram          String?
  
  whatsappSystemNumber String? // Para envio de mensagens automáticas / deep links
  
  msgNewRequest      String   @default("✨ Nova solicitação de agendamento\n\nCliente: {cliente}\nData: {data}\nHorário: {horario}\nProcedimento: {procedimento}\n\nAguardando confirmação.")
  msgConfirmed       String   @default("✅ Agendamento Confirmado!\n\nOlá {cliente}, seu horário para {procedimento} no dia {data} às {horario} está confirmado.")
  msgRejected        String   @default("❌ Agendamento Não Confirmado\n\nOlá {cliente}, infelizmente não poderemos atender sua solicitação para o dia {data} às {horario}.")
  
  minAdvanceMinutes  Int      @default(30)
  maxDaysAhead       Int      @default(30)
  pendingBlocksSlot  Boolean  @default(true)

  avatarUrl          String?  // Base64 ou URL da foto de perfil
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String   // Base64 string da imagem
  order     Int      @default(0)
  isFeature Boolean  @default(false)
  createdAt DateTime @default(now())
}
