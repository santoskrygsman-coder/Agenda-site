# ==============================================================================
# VARIÁVEIS DE AMBIENTE DE PRODUÇÃO (NETLIFY + SUPABASE POSTGRESQL)
# Configure no painel do Netlify: Site configuration > Environment variables
# ==============================================================================

# 1. CONEXÃO PRISMA COM SUPABASE POSTGRESQL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# 2. AUTENTICAÇÃO NEXTAUTH (PAINEL DA PROFISSIONAL)
NEXTAUTH_SECRET="[GERE-COM-OPENSSL-RAND-BASE64-32]"
NEXTAUTH_URL="https://SEU-SITE.netlify.app"

# 3. SUPABASE STORAGE (UPLOAD DE FOTOS HD DOS SERVIÇOS — SERVER-ONLY)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SUA-CHAVE-SERVICE-ROLE-DO-SUPABASE]"
SUPABASE_STORAGE_BUCKET="service-photos"

# 4. CREDENCIAIS ADMINISTRATIVAS DE PRODUÇÃO
ADMIN_PRODUCTION_EMAIL="contato@emilelash.com.br"
ADMIN_PRODUCTION_PASSWORD="[ DEFINA-UMA-SENHA-FORTE ]"
